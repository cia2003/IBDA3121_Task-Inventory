<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- ProgressBar di tengah -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"/>

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_text"
            android:textSize="40sp"
            android:layout_gravity="center"
            android:paddingBottom="16dp" />

        <!-- ROW 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- NEW -->
            <androidx.cardview.widget.CardView
                android:id="@+id/newStatusCard"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/newStatusName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/default_text"
                        android:textSize="30sp"
                        android:textAlignment="center"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/newStatusCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/default_text"
                        android:textSize="30sp"
                        android:textAlignment="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- IN PROGRESS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/inProgressStatusCard"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/inProgressStatusName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/default_text"
                        android:textSize="30sp"
                        android:textAlignment="center"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/inProgressStatusCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/default_text"
                        android:textSize="30sp"
                        android:textAlignment="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ROW 2 : DONE -->
        <androidx.cardview.widget.CardView
            android:id="@+id/doneStatusCard"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_margin="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/doneStatusName"
                    android:text="@string/default_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="30sp"
                    android:textAlignment="center"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/doneStatusCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/default_text"
                    android:textSize="30sp"
                    android:textAlignment="center"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <Space
            android:layout_width="match_parent"
            android:layout_height="50dp"/>

        <Button
            android:id="@+id/addButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="40dp"
            android:textSize="20sp"
            android:text="@string/add_button_text" />


    </LinearLayout>
    <!-- TITLE -->
</LinearLayout>
